# Environment variables — copy to .env and fill in values
# Never commit the real .env file (it is in .gitignore)

# ── Backend ────────────────────────────────────────────────────────────────────
# URL the React frontend is served from (used for CORS allow-origin)
FRONTEND_URL=http://localhost:3000

# Backend port (used by cloud hosts; defaults to 8000 if unset)
PORT=8000

# ── Crisis helpline (overrides app_config.py) ─────────────────────────────────
# CRISIS_HELPLINE_NUMBER=14416
# CRISIS_HELPLINE_NAME=Tele-MANAS

# ── Streamlit ──────────────────────────────────────────────────────────────────
# URL of the deployed backend (used by Streamlit Cloud)
# BACKEND_URL=http://localhost:8000
